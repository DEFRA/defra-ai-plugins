#!/usr/bin/env bash
# Format the repo with Prettier before each commit.
#
# Activate once per checkout:
#   git config core.hooksPath .githooks
#
# Behaviour: runs `npx prettier --write .` on the whole tree (paths in
# .prettierignore are skipped). Only files that were already staged get
# re-added — unstaged tracked changes are left alone, so a stray edit
# elsewhere does not silently slip into the commit.
set -euo pipefail

# Snapshot the index before formatting so we know what to re-add.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

npx --no-install prettier --write .

if [ -n "$STAGED" ]; then
  # Re-stage only the originally-staged paths that still exist.
  printf '%s\n' "$STAGED" \
    | while IFS= read -r f; do
        [ -e "$f" ] && git add -- "$f"
      done
fi
