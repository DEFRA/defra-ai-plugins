{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"${CLAUDE_PLUGIN_ROOT}\"/scripts/redact_pii.py",
            "statusMessage": "pii-redact-prompt: redacting PII from prompt...",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"${CLAUDE_PLUGIN_ROOT}\"/scripts/redact_pii.py",
            "statusMessage": "pii-redact-pre: redacting PII from tool input...",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"${CLAUDE_PLUGIN_ROOT}\"/scripts/redact_pii.py",
            "statusMessage": "pii-redact-post: redacting PII from tool output...",
            "async": false
          }
        ]
      }
    ]
  }
}
