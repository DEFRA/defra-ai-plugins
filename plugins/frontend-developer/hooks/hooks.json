{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/forbidden-tech-block.mjs\"",
            "statusMessage": "Checking for forbidden frontend tech...",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-format-on-write.mjs\"",
            "statusMessage": "Linting and formatting...",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/scss-build-on-write.mjs\"",
            "statusMessage": "Building CSS...",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/nunjucks-security.mjs\"",
            "statusMessage": "Checking Nunjucks security...",
            "async": false
          }
        ]
      }
    ]
  }
}
