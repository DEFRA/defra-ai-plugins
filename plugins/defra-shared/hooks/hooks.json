{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/branch-guard.mjs\"",
            "statusMessage": "branch-guard: checking git branch...",
            "async": false
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/commit-message-format.mjs\"",
            "statusMessage": "commit-message-format: validating commit subject...",
            "async": false
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/secret-scan.mjs\"",
            "statusMessage": "secret-scan: scanning for hard-coded secrets...",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pii-scan.mjs\"",
            "statusMessage": "pii-scan: scanning for PII patterns...",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/coverage-floor.mjs\"",
            "statusMessage": "coverage-floor: checking coverage threshold...",
            "async": true
          }
        ]
      }
    ]
  }
}
